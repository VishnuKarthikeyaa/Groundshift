# ==============================================================================
# GROUNDSHIFT - Multi-Mission SAR Platform .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Large Satellite Data & Raw Radargrammetry Assets (STRICTLY EXCLUDED)
# ------------------------------------------------------------------------------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/metadata/.gitkeep
*.h5
*.he5
*.hdf5
*.nc
*.nc4
*.SAFE/
*.zip
*.tar
*.tar.gz
*.tgz
*.tif
*.tiff
*.vrt
*.dem
*.grd
*.slc
*.raw
*.dat

# ------------------------------------------------------------------------------
# 2. Python & Conda Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 3. Frontend & Node.js Artifacts
# ------------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
!.env.example

# ------------------------------------------------------------------------------
# 5. OS & IDE Specific Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
*.log
logs/
*.sqlite3
*.db-journal

