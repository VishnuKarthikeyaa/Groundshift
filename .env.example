# ==============================================================================
# GROUNDSHIFT Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
GROUNDSHIFT_ENV=development

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Memory Governor Constraints (16 GB Physical RAM Profile)
MAX_MEMORY_THRESHOLD_MB=6144
MIN_FREE_MEMORY_MB=2560

# Data Directories
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_METADATA_DIR=./data/metadata

# Logging
LOG_LEVEL=INFO

